# IntelliWealth Environment Configuration

# Backend JWT Secret
SECRET_KEY=intelliwealth_super_secret_jwt_key_2026_change_in_production

# Database URL (Default SQLite for local zero-config, PostgreSQL for production)
DATABASE_URL=sqlite:///./intelliwealth.db
# DATABASE_URL=postgresql://intelliwealth:intelliwealth_secret_db_pass@localhost:5432/intelliwealth_db

# Google Gemini API Key (Optional: fallbacks to built-in smart financial engine if omitted)
GEMINI_API_KEY=your_google_gemini_api_key_here
